{
  "version": 2,
  "outputDirectory": "build/web",
  "buildCommand": "bash vercel-build.sh",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(index\\.html|flutter_service_worker\\.js|version\\.json|sw\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|wasm|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|otf|webmanifest|json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
